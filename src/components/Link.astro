---
const { href = "/", title, ariaLabel } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = href.startsWith('/') ? `${base}${href}` : href;

const normalize = (p) => p.replace(/\/+$/, '') || '/';
const target = normalize(url);
const current = normalize(Astro.url.pathname);

const isActive = href === "/"
  ? current === target
  : current === target || current.startsWith(target + "/");
---

<a href={url} title={title} aria-label={ariaLabel} class={isActive ? 'is-active' : ''}><slot/></a>

<style lang="scss">
  a {
    color: #b3b3b3;
    margin: 0 24px;
    font-size: 18px;
    letter-spacing: 1.8px;
    text-decoration: none;
    position:relative;
    transition:all .33s ease;
    &:first-child {
      margin-left: 0;
    }

    &:last-child {
      margin-right: 0;
    }

    &:hover {
        color:#fff;
    }

    &.is-active {
      color:#fff;
      
      &:after {
        content:"";
        position:absolute;
        bottom:0;
        left:0;
        width:100%;
        height:2px;
        background-color:#fff;
      }
    }
  }
</style>
